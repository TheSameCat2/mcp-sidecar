<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Version info -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <SourceRevisionId>local</SourceRevisionId>
    <BuildDate>2026-01-01T00:00:00Z</BuildDate>
    
    <!-- Assembly info -->
    <AssemblyTitle>mcp-sidecar</AssemblyTitle>
    <AssemblyDescription>Build-aware code fact extraction via clangd</AssemblyDescription>
    <Company>TheSameCat</Company>
    <Product>mcp-sidecar</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />

  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema/*.sql" />
  </ItemGroup>

</Project>
